{
  "name": "ohos-cli-tools-manager",
  "version": "1.0.0",
  "description": "OHOS Command Line Tools version manager and release automation",
  "type": "module",
  "scripts": {
    "fetch-config": "node scripts/fetch-config-from-api.js",
    "sync-versions": "node scripts/sync-from-config.js",
    "fetch-urls": "node scripts/fetch-download-urls-from-api.js",
    "detect-version": "node scripts/detect-version.js",
    "download": "node scripts/download-platforms.js",
    "release-notes": "node scripts/generate-release-notes.js",
    "cli": "node cli.js",
    "update": "node cli.js full-update",
    "help": "node cli.js help"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
